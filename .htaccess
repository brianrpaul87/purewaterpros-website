Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Exclude the Where They Rest addon domain from Pure Water Pros redirects.
RewriteCond %{HTTP_HOST} ^(?:www\.)?wheretheyrest\.ca$ [NC]
RewriteRule ^ - [L]

# Canonical public address: force HTTPS and the preferred www hostname in one hop.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.purewaterpros\.ca$ [NC]
RewriteRule ^ https://www.purewaterpros.ca%{REQUEST_URI} [R=301,L]

# Temporary compatibility redirects for the field-experience cards.
# The first uploaded WebP copies were corrupted; point those public URLs at
# existing verified real field photos already stored in the legacy gallery.
RewriteRule ^assets/field-experience/uv-prefiltration-basement-install\.webp$ /images/gallery/Standalone%20Viqua%20VH200%20UV%20System.jpg [R=302,L,NE]
RewriteRule ^assets/field-experience/uv-prefiltration-clean-install\.webp$ /images/gallery/UV%20Dynamics%20Duplex.jpg [R=302,L,NE]
RewriteRule ^assets/field-experience/uv-softener-treatment-room\.webp$ /images/gallery/New%20Viqua%20VH200-F10%20UV%20System%20with%20Water%20Softener.jpg [R=302,L,NE]
RewriteRule ^assets/field-experience/under-sink-ro-compact-install\.webp$ /images/gallery/Quick%20Change%20RO%20System.jpg [R=302,L,NE]
RewriteRule ^assets/field-experience/under-sink-ro-drinking-water\.webp$ /images/gallery/6%20Stage%20Traditional%20RO%20System.jpg [R=302,L,NE]
RewriteRule ^assets/field-experience/under-sink-ro-watts-system\.webp$ /images/gallery/Quick%20Change%20RO%20System.jpg [R=302,L,NE]

# Do not expose /index.html as a second homepage URL.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ https://www.purewaterpros.ca/ [R=301,L]

# Do not expose /blog/index.html as a second blog index URL.
RewriteCond %{THE_REQUEST} \s/+blog/index\.html(?:[\s?]) [NC]
RewriteRule ^blog/index\.html$ https://www.purewaterpros.ca/blog/ [R=301,L]

# Retire the legacy Ontario gallery PHP page.
RewriteRule ^gallery\.php$ https://www.purewaterpros.ca/ [R=301,L,NC]

# Retire old/unknown HTML pages while allowing the current BC website pages.
# Blog pages are intentionally excluded from the legacy-page redirect.
RewriteCond %{REQUEST_URI} !^/blog(?:/.*)?$ [NC]
RewriteCond %{REQUEST_URI} !^/(?:thank-you|water-filtration-victoria|water-softeners-victoria|reverse-osmosis-victoria|uv-water-treatment-victoria|iron-sulfur-water-treatment-victoria|chemical-injection-water-treatment-victoria|low-yield-well-storage-victoria|water-treatment-service-victoria|service-areas|water-treatment-langford-west-shore|privacy-policy)\.html$ [NC]
RewriteRule ^.+\.html$ https://www.purewaterpros.ca/ [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
