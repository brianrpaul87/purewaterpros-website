Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Exclude the Where They Rest addon domain from Pure Water Pros redirects.
RewriteCond %{HTTP_HOST} ^(?:www\.)?wheretheyrest\.ca$ [NC]
RewriteRule ^ - [L]

# Canonical public address: force HTTPS and the preferred www hostname in one hop.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.purewaterpros\.ca$ [NC]
RewriteRule ^ https://www.purewaterpros.ca%{REQUEST_URI} [R=301,L]

# Do not expose /index.html as a second homepage URL.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ https://www.purewaterpros.ca/ [R=301,L]

# Do not expose /blog/index.html as a second blog index URL.
RewriteCond %{THE_REQUEST} \s/+blog/index\.html(?:[\s?]) [NC]
RewriteRule ^blog/index\.html$ https://www.purewaterpros.ca/blog/ [R=301,L]

# Permanent migration map for retired Ontario-era URLs.
# Keep these redirects even after the old source files are removed so search
# engines and old backlinks resolve to the closest current BC replacement.
RewriteRule ^contact\.html$ https://www.purewaterpros.ca/#launch-request [R=301,L,NE,NC]
RewriteRule ^(?:services/)?ro\.html$ https://www.purewaterpros.ca/reverse-osmosis-victoria.html [R=301,L,NC]
RewriteRule ^(?:services/)?softeners\.html$ https://www.purewaterpros.ca/water-softeners-victoria.html [R=301,L,NC]
RewriteRule ^(?:services/)?uv\.html$ https://www.purewaterpros.ca/uv-water-treatment-victoria.html [R=301,L,NC]
RewriteRule ^(?:services/)?iron-sulfur\.html$ https://www.purewaterpros.ca/iron-sulfur-water-treatment-victoria.html [R=301,L,NC]
RewriteRule ^city-water-issues\.html$ https://www.purewaterpros.ca/water-filtration-victoria.html [R=301,L,NC]
RewriteRule ^well-water-issues\.html$ https://www.purewaterpros.ca/water-filtration-victoria.html [R=301,L,NC]
RewriteRule ^gallery\.(?:html|php)$ https://www.purewaterpros.ca/ [R=301,L,NC]

# Known legacy URLs are redirected explicitly above. Unknown URLs fall through normally.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
